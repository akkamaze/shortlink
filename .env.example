# Copy to .env and fill in. Never commit .env.

# Postgres container. The superuser only bootstraps the cluster; postgres/init creates
# shortlink_owner (runs migrations) and shortlink_app (what the app connects as).
POSTGRES_PASSWORD=change-me-superuser
SHORTLINK_OWNER_PASSWORD=change-me-owner
SHORTLINK_APP_PASSWORD=change-me-app
POSTGRES_PORT=5432
# Local default. When deployed, put it outside the repo.
PG_DATA_DIR=./.data/postgres

# Migrations run as the owner role, never at app start. Can also come from
# MIGRATION_DATABASE_URL_FILE (Docker secrets).
MIGRATION_DATABASE_URL=postgres://shortlink_owner:change-me-owner@127.0.0.1:5432/shortlink

# App
BIND_ADDR=127.0.0.1:3100
# https here turns on HSTS and Secure cookies.
PUBLIC_BASE_URL=http://localhost:3100
DATABASE_URL=postgres://shortlink_app:change-me-app@127.0.0.1:5432/shortlink

# 64 random bytes, base64. Generate with: openssl rand -base64 64 | tr -d '\n'
COOKIE_KEY=

# 32+ random bytes, base64. Seals emails and names and keys identity lookups.
# Keep it out of the database and its backups; losing it makes stored profiles unreadable.
# Generate with: openssl rand -base64 32
DATA_KEY=

# Any secret above can come from a file instead: set COOKIE_KEY_FILE, DATA_KEY_FILE,
# DATABASE_URL_FILE, MIGRATION_DATABASE_URL_FILE, GOOGLE_CLIENT_SECRET_FILE or
# LINE_CLIENT_SECRET_FILE to its path (Docker secrets).

# Google sign-in. For local development, point it at the mock provider:
#   docker compose --profile dev up -d
#   GOOGLE_ISSUER_URL=http://localhost:8080/default, any client id and secret.
GOOGLE_ISSUER_URL=https://accounts.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE sign-in, optional: leave LINE_CLIENT_ID empty to hide it. Use the channel ID and secret
# of a LINE Login channel whose callback URL is PUBLIC_BASE_URL + /auth/line/callback.
# For local development: LINE_ISSUER_URL=http://localhost:8080/line, any client id and secret.
LINE_ISSUER_URL=https://access.line.me
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
